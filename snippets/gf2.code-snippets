"gf2": {
  "prefix": ">>gf2",
  "body": [
    "// https://github.com/kss418/template/blob/master/docs/Geometry.md#gf2",
    "template <size_t m>",
    "class _gf2{ // 0-based index",
    "public:",
    "    enum class state{ inconsistent, unique, multiple };",
    "    class result{",
    "    public:",
    "        state status;",
    "        bitset <m> value; ll rk, fr;",
    "        vector <bitset <m>> basis;",
    "        bool inconsistent() const{ return status == state::inconsistent; } // O(1)",
    "        bool unique() const{ return status == state::unique; } // O(1)",
    "        bool multiple() const{ return status == state::multiple; } // O(1)",
    "        const bitset <m>& get_value() const{ return value; } // O(1)",
    "        const vector <bitset <m>>& get_basis() const{ return basis; } // O(1)",
    "        ll rank() const{ return rk; } // O(1)",
    "        ll free_count() const{ return fr; } // O(1)",
    "    };",
    "private:",
    "    vector <bitset <m + 1>> bs;",
    "    result ans{};",
    "public:",
    "    _gf2(ll n = 0) : bs(n){}",
    "    ll rows() const{ return bs.size(); } // O(1)",
    "    const bitset <m + 1>& get_row(ll cy) const{ return bs[cy]; } // O(1)",
    "    void set_row(ll cy, const bitset <m + 1>& v){ bs[cy] = v; }",
    "    void set_a(ll cy, ll cx, bool v){ bs[cy][cx] = v; }",
    "    void set_b(ll cy, bool v){ bs[cy][m] = v; }",
    "    void clear(){ for(auto& i : bs) i.reset(); }",
    "    void clear(ll n){ bs.assign(n, {}); }",
    "",
    "    void build(bool with_basis = 0){",
    "        ll n = bs.size();",
    "        auto arr = bs; vector <ll> pos(m, -1);",
    "        ll cy = 0;",
    "        for(ll cx = 0;cx < m && cy < n;cx++){",
    "            ll now = -1;",
    "            for(ll i = cy;i < n;i++){",
    "                if(!arr[i][cx]) continue;",
    "                now = i; break;",
    "            }",
    "            if(now == -1) continue;",
    "",
    "            swap(arr[now], arr[cy]);",
    "            pos[cx] = cy;",
    "            for(ll i = 0;i < n;i++){",
    "                if(i == cy || !arr[i][cx]) continue;",
    "                arr[i] ^= arr[cy];",
    "            }",
    "            cy++;",
    "        }",
    "",
    "        ans = {cy == m ? state::unique : state::multiple, {}, cy, (ll)m - cy, {}};",
    "        for(ll i = cy;i < n;i++){",
    "            if(!arr[i][m]) continue;",
    "            ans.status = state::inconsistent; break;",
    "        }",
    "        if(!ans.inconsistent()){",
    "            for(ll i = 0;i < m;i++) if(pos[i] != -1) ans.value[i] = arr[pos[i]][m];",
    "        }",
    "        if(!with_basis) return;",
    "        ans.basis.reserve(ans.fr);",
    "        for(ll j = 0;j < m;j++){",
    "            if(pos[j] != -1) continue;",
    "            bitset <m> v; v[j] = 1;",
    "            for(ll i = 0;i < m;i++) if(pos[i] != -1) v[i] = arr[pos[i]][j];",
    "            ans.basis.push_back(v);",
    "        }",
    "    }",
    "",
    "    const result& ret() const{ return ans; } // O(1)",
    "};"
  ],
  "description": "GF(2) linear system with m compile-time variables and zero-based row/column indices. rows() returns the equation count. set_row/get_row write/read an augmented bitset<m+1> row; coefficient bits are [0,m) and bit m is the RHS. get_row returns a const reference. clear() zeros rows without changing their count; clear(n) replaces input with n zero rows. Call build() after input changes, then ret() reads cached status/rank/free count and a solution with free variables zero when consistent. build(true) additionally caches a nullspace basis in ret().get_basis(), one vector per free column in ascending column order, independent of the RHS even when inconsistent. Basic build() leaves the basis empty. Basis vectors span ker(A); when consistent, every solution is get_value() XOR a basis combination. Basis construction adds O(m*(1+m-rank)) scalar work and O((m-rank)*ceil(m/word_bits)) words of storage."
}
