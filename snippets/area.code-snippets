{
  "area": {
    "prefix": ">>area",
    "body": [
      "namespace _area{",
      "    inline ll ret(span<const pll> v){ // div by 2",
      "        i128 num = 0;",
      "        for(int i = 0;i < v.size();i++){",
      "            auto [x1, y1] = v[i];",
      "            auto [x2, y2] = v[(i + 1) % v.size()];",
      "            num += (i128)x1 * y2 - (i128)x2 * y1;",
      "        }",
      "",
      "        return (ll)abs(num);",
      "    }",
      "}"
    ],
    "description": "Polygon doubled area via _area::ret(span<const pll>); returns ll."
  }
}
