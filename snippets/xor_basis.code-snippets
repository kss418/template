  "xor_basis": {
    "prefix": ">>xor_basis",
    "body": [
      "template <size_t N = 64> requires (N <= 64)",
      "class _xor_basis{",
      "private:",
      "    array<u64, N> basis{}; int rk = 0;",
      "public:",
      "    _xor_basis(){ clear(); } // O(max_bit)",
      "    void clear(){ basis.fill(0); rk = 0; } // O(max_bit)",
      "",
      "    bool insert(u64 x){ // O(max_bit)",
      "        for(int i = (int)N - 1; i >= 0; i--){",
      "            if(((x >> i) & 1ull) == 0) continue;",
      "            if(!basis[i]){",
      "                basis[i] = x; rk++;",
      "                return 1;",
      "            }",
      "            x ^= basis[i];",
      "        }",
      "        return 0;",
      "    }",
      "",
      "    bool can_make(u64 x) const{ // O(max_bit)",
      "        for(int i = (int)N - 1; i >= 0; i--){",
      "            if(((x >> i) & 1ull) == 0) continue;",
      "            if(!basis[i]) return 0;",
      "            x ^= basis[i];",
      "        }",
      "        return x == 0;",
      "    }",
      "",
      "    u64 max_xor(u64 x = 0) const{ // O(max_bit)",
      "        u64 ret = x;",
      "        for(int i = (int)N - 1; i >= 0; i--) ret = max(ret, ret ^ basis[i]);",
      "        return ret;",
      "    }",
      "",
      "    u64 min_xor(u64 x = 0) const{ // O(max_bit)",
      "        u64 ret = x;",
      "        for(int i = (int)N - 1; i >= 0; i--) ret = min(ret, ret ^ basis[i]);",
      "        return ret;",
      "    }",
      "",
      "    const array<u64, N>& get_basis() const{ return basis; } // O(1)",
      "    int rank() const{ return rk; } // O(1)",
      "};"
    ],
    "description": "XOR linear basis over u64 with 0 <= N <= 64 bits (default 64). insert requires its input to fit N bits; this precondition is unchecked. can_make tests exact membership, including queries with bits above N. get_basis returns a const reference to the pivot-indexed array, with zero for unused slots. max_xor/min_xor optimize seed XOR a representable value; rank returns the dimension."
  }
}
