      "        u64 ret = x;",
      "        for(int i = (int)N - 1; i >= 0; i--) ret = max(ret, ret ^ basis[i]);",
      "        return ret;",
      "    }",
      "",
      "    u64 min_xor(u64 x = 0) const{ // O(max_bit)",
      "        u64 ret = x;",
      "        for(int i = (int)N - 1; i >= 0; i--) ret = min(ret, ret ^ basis[i]);",
      "        return ret;",
      "    }",
