      "    void clear(){ basis.fill(0); rk = 0; } // O(max_bit)",
      "",
      "    bool insert(u64 x){ // O(max_bit)",
      "        for(int i = (int)N - 1; i >= 0; i--){",
      "            if(((x >> i) & 1ull) == 0) continue;",
      "            if(!basis[i]){",
