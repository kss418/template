      "                return 1;",
      "            }",
      "            x ^= basis[i];",
      "        }",
      "        return 0;",
      "    }",
      "",
      "    void merge(const _xor_basis& ot){ // O(max_bit^2)",
      "        for(auto v : ot.basis) if(v) insert(v);",
      "    }",
      "",
      "    bool can_make(u64 x) const{ // O(max_bit)",
      "        for(int i = (int)N - 1; i >= 0; i--){",
      "            if(((x >> i) & 1ull) == 0) continue;",
      "            if(!basis[i]) return 0;",
      "            x ^= basis[i];",
      "        }",
      "        return x == 0;",
      "    }",
      "",
