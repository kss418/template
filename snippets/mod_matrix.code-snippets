"mod_matrix": {
  "prefix": ">>mod_matrix",
  "body": [
    "template <u64 mod = 998244353>",
    "class _mod_matrix{ // 0-based index, Require _mint",
    "public:",
    "    using mint = _mint<mod>;",
    "private:",
    "    int n, m; vector <mint> arr;",
    "public:",
    "    _mod_matrix() : n(0), m(0){}",
    "    _mod_matrix(int n, int m) : n(n), m(m), arr(1LL * n * m){}",
    "",
    "    int rows() const{ return n; } // O(1)",
    "    int cols() const{ return m; } // O(1)",
    "",
    "    mint& at(int i, int j){ return arr[1LL * i * m + j]; }",
    "    const mint& at(int i, int j) const{ return arr[1LL * i * m + j]; }",
    "    void add(int i, int j, ll v){ at(i, j) += v; }",
    "    void set(int i, int j, ll v){ at(i, j) = v; }",
    "",
    "    static _mod_matrix id(int n){",
    "        _mod_matrix ret(n, n);",
    "        for(int i = 0; i < n; i++) ret.at(i, i) = 1;",
    "        return ret;",
    "    }",
    "",
    "    _mod_matrix& operator+=(const _mod_matrix& ot){",
    "        assert(n == ot.n && m == ot.m);",
    "        for(ll i = 0;i < arr.size();i++) arr[i] += ot.arr[i];",
    "        return *this;",
    "    }",
    "",
    "    _mod_matrix& operator-=(const _mod_matrix& ot){",
    "        assert(n == ot.n && m == ot.m);",
    "        for(ll i = 0;i < arr.size();i++) arr[i] -= ot.arr[i];",
    "        return *this;",
    "    }",
    "",
    "    _mod_matrix& operator*=(const _mod_matrix& ot){",
    "        assert(m == ot.n);",
    "        _mod_matrix ret(n, ot.m);",
    "        for(int i = 0; i < n; i++){",
    "            for(int k = 0; k < m; k++){",
    "                const mint v = at(i, k);",
    "                if(!v.v) continue;",
    "                for(int j = 0; j < ot.m; j++) ret.at(i, j) += v * ot.at(k, j);",
    "            }",
    "        }",
    "        m = ret.m; arr.swap(ret.arr);",
    "        return *this;",
    "    }",
    "",
    "    friend _mod_matrix operator+(_mod_matrix a, const _mod_matrix& b){ a += b; return a; }",
    "    friend _mod_matrix operator-(_mod_matrix a, const _mod_matrix& b){ a -= b; return a; }",
    "    friend _mod_matrix operator*(_mod_matrix a, const _mod_matrix& b){ a *= b; return a; }",
    "    friend bool operator==(const _mod_matrix& a, const _mod_matrix& b) = default;",
    "",
    "    _mod_matrix pow(u64 k) const{ // n*n matrix",
    "        assert(n == m);",
    "        _mod_matrix base = *this, ret = id(n);",
    "        while(k > 0){",
    "            if(k & 1) ret *= base;",
    "            k >>= 1;",
    "            if(k) base *= base;",
    "        }",
    "        return ret;",
    "    }",
    "",
    "    _mod_matrix transpose() const{",
    "        _mod_matrix ret(m, n);",
    "        for(int i = 0;i < n;i++) for(int j = 0;j < m;j++) ret.at(j, i) = at(i, j);",
    "        return ret;",
    "    }",
    "",
    "    friend ostream& operator<<(ostream& out, const _mod_matrix& cur){",
    "        for(int i = 0; i < cur.n; i++){",
    "            for(int j = 0; j < cur.m; j++) out << cur.at(i, j) << \" \";",
    "            out << \"\\n\";",
    "        }",
    "        return out;",
    "    }",
    "};"
  ],
  "description": "Modular matrix over _mint<mod>; requires >>mint. Zero-based at(i,j) access and rows()/cols() dimension getters. Supports +, -, *, +=, -=, *= and shape-aware equality; *= supports self-multiplication and rectangular results. pow(u64 k) requires a square matrix and skips the final unused square. set/add retain ll value parameters."
}
