{
  "hld_path": {
    "prefix": ">>hld_path",
    "body": [
      "template<class P>",
      "concept is_action = requires(P s, int l, int r, const typename P::lazy& z){ s.update(l, r, z); };",
      "",
      "template<class backend>",
      "class _hld_path : public _hld {",
      "public:",
      "    using node = typename backend::node;",
      "    backend seg;",
      "private:",
      "    static constexpr bool can_const_query = requires(const backend& s, int l, int r, const node& a){",
      "        { s.query(l, r) } -> std::convertible_to<node>;",
      "        { s.id() } -> std::convertible_to<node>;",
      "        { s.op(a, a) } -> std::convertible_to<node>;",
      "    };",
      "    bool built = 0;",
      "    void reset_seg(){",
      "        if constexpr (requires(backend& s){ s.clear(n, 0); }) seg.clear(n, 0);",
      "        else seg.clear(n);",
      "    }",
      "",
      "    template<class S>",
      "    node query_path(S& s, int st, int en) const{",
      "        node ret = s.id();",
      "        it_path(st, en, [&](int l, int r, bool rev){",
      "            node part = s.query(l, r);",
      "            if constexpr (requires(const node& v){ { v.reversed() } -> std::same_as<node>; }){",
      "                if(rev) part = part.reversed();",
      "            }",
      "            ret = s.op(ret, part);",
      "        });",
      "        return ret;",
      "    }",
      "public:",
      "    _hld_path(int n = 0, int m = 0, bool base = 1) : _hld(n, m, base){ reset_seg(); }",
      "    void clear(int n, int m = 0, bool base = 1){",
      "        _hld::clear(n, m, base); reset_seg(); built = 0;",
      "    }",
      "",
      "    void build(){",
      "        vector<node> values;",
      "        if(built){",
      "            values.assign(n + 1, seg.id());",
      "            for(int v = base; v <= n; ++v) values[v] = seg.query(in[v], in[v]);",
      "        }",
      "        _hld::build();",
      "        if(built) make(values);",
      "        built = 1;",
      "    }",
      "",
      "    void make(span<const node> values){",
      "        vector<node> ordered(n + 1, seg.id());",
      "        for(int v = base; v <= n && v < (int)values.size(); ++v) ordered[in[v]] = values[v];",
      "        if constexpr (requires(backend& s, span<const node> a){ s.make(a); }) seg.make(ordered);",
      "        else {",
      "            reset_seg();",
      "            for(int v = base; v <= n; ++v) seg.set(in[v], ordered[in[v]]);",
      "        }",
      "    }",
      "",
      "    node query(int x){",
      "        return seg.query(in[x], in[x]);",
      "    }",
      "",
      "    node query(int x) const requires can_const_query{",
      "        return seg.query(in[x], in[x]);",
      "    }",
      "",
      "    node query(int st, int en){ // O(log^2 n)",
      "        return query_path(seg, st, en);",
      "    }",
      "",
      "    node query(int st, int en) const requires can_const_query{ // O(log^2 n)",
      "        return query_path(seg, st, en);",
      "    }",
      "",
      "    node query_sub(int x){ auto [l, r] = subtree(x); return seg.query(l, r); }",
      "    node query_sub(int x) const requires can_const_query{ auto [l, r] = subtree(x); return seg.query(l, r); }",
      "    void set(int x, const node& v)",
      "        requires requires(backend s, int i, const node& nv){ s.set(i, nv); }",
      "    { seg.set(in[x], v); }",
      "",
      "    void update(int x, const node& v)",
      "        requires requires(backend s, int i, const node& nv){ s.update(i, nv); }",
      "    { seg.update(in[x], v); }",
      "",
      "    template<is_action P = backend>",
      "    void update(int st, int en, const typename P::lazy& lz)",
      "    {",
      "        it_path(st, en, [&](int l, int r, bool){ seg.update(l, r, lz); });",
      "    }",
      "",
      "    template<is_action P = backend>",
      "    void update_sub(int x, const typename P::lazy& lz)",
      "    { auto [l, r] = subtree(x); seg.update(l, r, lz); }",
      "};"
    ],
    "description": "HLD backend adapter; requires >>hld and a segment-tree backend."
  }
}
