{
  "kmp": {
    "prefix": ">>kmp",
    "body": [
      "template <class T>",
      "class kmp_policy{",
      "public:",
      "    static void build(span<const T>){}",
      "    static bool build_chk(span<const T> pat, int cur, int state){ return pat[cur] == pat[state]; }",
      "    static bool match_chk(span<const T> pat, const T& value, int state){ return value == pat[state]; }",
      "};",
      "",
      "template <class T = ll, class policy = kmp_policy<T>>",
      "class _kmp{ // 0-based index",
      "private:",
      "    int m;",
      "    vector <T> pat; vector <int> arr; policy cmp;",
      "    void build(){",
      "        m = (int)pat.size(); cmp.build(span<const T>(pat));",
      "        int nxt = 0; arr.assign(m, 0);",
      "        for(int cur = 1;cur < m;cur++){",
      "            while(nxt && !build_chk(cur, nxt)) nxt = arr[nxt - 1];",
      "            if(build_chk(cur, nxt)) arr[cur] = ++nxt;",
      "        }",
      "    }",
      "",
      "    bool build_chk(int cur, int nxt) const{",
      "        return cmp.build_chk(span<const T>(pat), cur, nxt);",
      "    }",
      "",
      "    bool match_chk(span<const T> v, int idx, int state) const{",
      "        if constexpr(requires{ cmp.match_chk(span<const T>(pat), v, idx, state); })",
      "            return cmp.match_chk(span<const T>(pat), v, idx, state);",
      "        else return cmp.match_chk(span<const T>(pat), v[idx], state);",
      "    }",
      "",
      "    template <class F>",
      "    int step(int state, const F& f) const{",
      "        if(!m) return 0;",
      "        if(state == m) state = arr[m - 1];",
      "        while(state && !f(state)) state = arr[state - 1];",
      "        if(f(state)) state++;",
      "        return state;",
      "    }",
      "",
      "    static vector <T> tf(const string& s){",
      "        vector <T> ret; ret.reserve(s.size());",
      "        for(unsigned char c : s) ret.push_back(T(c));",
      "        return ret;",
      "    }",
      "public:",
      "    _kmp() : m(0){}",
      "    _kmp(const string& s, policy cmp = {}) : cmp(move(cmp)){ make(s); }",
      "    _kmp(span<const T> v, policy cmp = {}) : cmp(move(cmp)){ make(v); }",
      "    _kmp(const _kmp& other) requires (is_copy_constructible_v<policy>)",
      "        : pat(other.pat), cmp(other.cmp){ build(); }",
      "    _kmp(_kmp&&) = default;",
      "",
      "    _kmp& operator=(const _kmp& other) requires (is_copy_assignable_v<policy>){",
      "        if(this == &other) return *this;",
      "        pat = other.pat; cmp = other.cmp; build();",
      "        return *this;",
      "    }",
      "",
      "    _kmp& operator=(_kmp&&) = default;",
      "    void clear(){ pat.clear(); arr.clear(); m = 0; cmp.build(span<const T>(pat)); }",
      "    void make(const string& s){ pat = tf(s); build(); }",
      "    void make(span<const T> v){ pat.assign(all(v)); build(); }",
      "",
      "    const vector<int>& fail() const{ return arr; } // O(1)",
      "    template <class F>",
      "    void it_match(const string& s, const F& f) const{ it_match(tf(s), f); } // O(|s| + m) checks",
      "    template <class F>",
      "    void it_match(span<const T> v, const F& f) const{ // O(|v| + m) checks",
      "        int n = (int)v.size();",
      "        if(!m) return; int state = 0;",
      "        for(int i = 0;i < n;i++){",
      "            state = go(state, v, i);",
      "            if(state == m) f(i - m + 1);",
      "        }",
      "    }",
      "",
      "    int go(int state, const T& value) const",
      "        requires requires{ cmp.match_chk(span<const T>(pat), value, state); }{ // O(m) checks, amortized O(1) checks",
      "        return step(state, [&](int nxt){ return cmp.match_chk(span<const T>(pat), value, nxt); });",
      "    }",
      "",
      "    int go(int state, span<const T> v, int idx) const{ // O(m) checks, amortized O(1) checks",
      "        return step(state, [&](int nxt){ return match_chk(v, idx, nxt); });",
      "    }",
      "",
      "    template <class F>",
      "    void it_border(const F& f) const{ // O(m)",
      "        if(!m) return;",
      "        for(int x = arr[m - 1];x > 0;x = arr[x - 1]) f(x);",
      "    }",
      "};"
    ],
    "description": "KMP<T,policy=kmp_policy<T>>. Policy build(pat), build_chk(pat,cur,state), scalar match_chk(pat,value,state) and/or contextual match_chk(pat,text,idx,state). Per-object metadata; failure/search conditions must be compatible. Scalar go requires scalar hook; contextual go prefers contextual hook. Includes default equality policy."
  }
}
