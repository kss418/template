{
"ls": {
  "prefix": ">>ls",
  "body": [
    "class _ls{",
    "private:",
    "    vector <int> lp, prime, vphi, vmu;",
    "public:",
    "    static constexpr int with_phi = 1, with_mobius = 2;",
    "",
    "    _ls() = default;",
    "    _ls(int n, int flag = 0){ build(n, flag); }",
    "",
    "    void build(int n, int flag = 0){ // O(n)",
    "        bool do_phi = flag & with_phi, do_mu = flag & with_mobius;",
    "        prime.clear(); vphi.clear(); vmu.clear();",
    "        lp.assign(n + 1, 0);",
    "        if(n >= 3) prime.reserve((int)(n / log((ld)n)) + 10);",
    "        if(do_phi){ vphi.assign(n + 1, 0); if(n >= 1) vphi[1] = 1; }",
    "        if(do_mu){ vmu.assign(n + 1, 0); if(n >= 1) vmu[1] = 1; }",
    "",
    "        for(int i = 2;i <= n;i++){",
    "            if(!lp[i]){",
    "                lp[i] = i;",
    "                prime.push_back(i);",
    "                if(do_phi) vphi[i] = i - 1;",
    "                if(do_mu) vmu[i] = -1;",
    "            }",
    "",
    "            int least = lp[i];",
    "            for(int p : prime){",
    "                ll x = 1ll * p * i;",
    "                if(x > n) break;",
    "                lp[x] = p;",
    "",
    "                if(p == least){",
    "                    if(do_phi) vphi[x] = vphi[i] * p;",
    "                    if(do_mu) vmu[x] = 0;",
    "                    break;",
    "                }",
    "                if(do_phi) vphi[x] = vphi[i] * (p - 1);",
    "                if(do_mu) vmu[x] = -vmu[i];",
    "            }",
    "        }",
    "    }",
    "",
    "    const vector<int>& ret() const{ return prime; } // O(1)",
    "    int count() const{ return prime.size(); } // O(1)",
    "    int count(int l, int r) const{ // O(log pi(n))",
    "        if(l > r) return 0;",
    "        return upper_bound(all(prime), r) - lower_bound(all(prime), l);",
    "    }",
    "    template <class F>",
    "    void it_prime(const F& f) const{ for(int p : prime) f(p); } // O(pi(n))",
    "    bool is_prime(int x) const{ x = abs(x); return x >= 2 && lp[x] == x; } // O(1)",
    "",
    "    template <class F>",
    "    void it_factor(int x, const F& f) const{ // O(log |x|)",
    "        if(!x) return;",
    "        x = abs(x);",
    "        while(x != 1){",
    "            int p = lp[x], c = 0;",
    "            do{ x /= p; c++; }while(lp[x] == p);",
    "            f(p, c);",
    "        }",
    "    }",
    "",
    "    vector <int> factorize(int x) const{ // 소인수분해",
    "        if(!x) return {};",
    "        x = abs(x);",
    "        vector <int> ret;",
    "        while(x != 1){",
    "            ret.push_back(lp[x]);",
    "            x /= lp[x];",
    "        }",
    "        return ret;",
    "    }",
    "",
    "    vector <pair<int, int>> factorize_cnt(int x) const{ // p^c 꼴로 소인수분해",
    "        vector <pair<int, int>> ret;",
    "        it_factor(x, [&](int p, int c){ ret.emplace_back(p, c); });",
    "        return ret;",
    "    }",
    "",
    "    int divisor_num(int x) const{ // 약수의 개수",
    "        if(!x) return 0;",
    "        int ret = 1;",
    "        it_factor(x, [&](int, int c){ ret *= c + 1; });",
    "        return ret;",
    "    }",
    "",
    "    ll divisor_sum(int x) const{ // 약수의 합",
    "        if(!x) return 0;",
    "        ll ret = 1;",
    "        it_factor(x, [&](int p, int c){",
    "            ll sum = 1, cur = 1;",
    "            for(int i = 0;i < c;i++){",
    "                cur *= p;",
    "                sum += cur;",
    "            }",
    "            ret *= sum;",
    "        });",
    "        return ret;",
    "    }",
    "",
    "    vector <int> divisor(int x) const{ // 약수 벡터 반환",
    "        if(!x) return {};",
    "        vector <int> ret = {1};",
    "        it_factor(x, [&](int p, int c){",
    "            int mul = 1, sz = ret.size();",
    "            for(int k = 0;k < c;k++){",
    "                mul *= p;",
    "                for(int i = 0;i < sz;i++) ret.push_back(ret[i] * mul);",
    "            }",
    "        });",
    "",
    "        sort(all(ret));",
    "        return ret;",
    "    }",
    "",
    "    int phi(int x) const{ return x ? vphi[abs(x)] : 0; } // O(1)",
    "    int mobius(int x) const{ return x ? vmu[abs(x)] : 0; } // O(1)",
    "};"
  ],
  "description": "Linear sieve on [0,n]. Call build(n, flag) to set the limit and options. Single-value queries require |x| <= n and use |x|. At zero, they return 0, false or an empty vector; it_factor makes no callbacks. Nonzero phi and mobius require with_phi and with_mobius respectively. it_factor(x, f) calls f(p, exponent) in ascending prime order."
}
}
