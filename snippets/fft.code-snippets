{
"fft": {
  "prefix": ">>fft",
  "body": [
    "template<size_t size>",
    "class _fft{",
    "private:",
    "    using cpd = complex<double>;",
    "    static constexpr size_t n = size ? bit_ceil(size) : 0;",
    "    static void transform(vector<cpd>& v, bool inv){ // O(n log n)",
    "        if(n < 2) return;",
    "        for(size_t i = 1, j = 0; i < n; i++){",
    "            size_t bit = n >> 1;",
    "            for(; j & bit; bit >>= 1) j ^= bit;",
    "            j ^= bit;",
    "            if(i < j) swap(v[i], v[j]);",
    "        }",
    "        const double pi = acos(-1.0);",
    "        for(size_t k = 1; k < n; k <<= 1){",
    "            double angle = pi / k * (inv ? 1 : -1);",
    "            cpd w(cos(angle), sin(angle));",
    "            for(size_t i = 0; i < n; i += 2 * k){",
    "                cpd wp(1, 0);",
    "                for(size_t j = 0; j < k; j++){",
    "                    cpd left = v[i + j], right = v[i + j + k] * wp;",
    "                    v[i + j] = left + right;",
    "                    v[i + j + k] = left - right;",
    "                    wp *= w;",
    "                }",
    "            }",
    "        }",
    "        if(inv) for(auto& value : v) value /= (double)n;",
    "    }",
    "public:",
    "    class node{",
    "        friend class _fft;",
    "    private:",
    "        vector<cpd> v;",
    "        size_t len;",
    "        node(size_t len) : v(n), len(len){}",
    "    public:",
    "        node& operator+=(const node& other){ // O(n)",
    "            for(size_t i = 0; i < n; i++) v[i] += other.v[i];",
    "            len = max(len, other.len);",
    "            return *this;",
    "        }",
    "",
    "        node& operator*=(const node& other){ // O(n)",
    "            for(size_t i = 0; i < n; i++) v[i] *= other.v[i];",
    "            len = len && other.len ? len + other.len - 1 : 0;",
    "            return *this;",
    "        }",
    "",
    "        friend node operator+(node a, const node& b){ // O(n)",
    "            a += b;",
    "            return a;",
    "        }",
    "",
    "        friend node operator*(node a, const node& b){ // O(n)",
    "            a *= b;",
    "            return a;",
    "        }",
    "",
    "        friend ostream& operator<<(ostream& out, const node& value){ // O(n log n)",
    "            auto arr = _fft{}.inverse(value);",
    "            if(arr.empty()) return out << 0;",
    "            for(size_t i = arr.size(); i--;) out << arr[i];",
    "            return out;",
    "        }",
    "    };",
    "",
    "    template<integral T>",
    "    node make(const vector<T>& arr) const{ // O(n log n)",
    "        node ret(arr.size());",
    "        for(size_t i = 0; i < arr.size(); i++) ret.v[i] = (double)arr[i];",
    "        transform(ret.v, 0);",
    "        return ret;",
    "    }",
    "",
    "    template<integral T = ll>",
    "    vector<T> inverse(const node& value) const{ // O(n log n)",
    "        if(!value.len) return {};",
    "        auto v = value.v; transform(v, 1);",
    "        vector<T> ret(value.len);",
    "        for(size_t i = 0; i < value.len; i++) ret[i] = (T)round(v[i].real());",
    "        return ret;",
    "    }",
    "",
    "    node carry(const node& value, ll radix = 10) const{ // O(n log n)",
    "        auto ret = inverse(value);",
    "        if(ret.empty()) return value;",
    "        i128 c = 0;",
    "        for(auto& digit : ret){",
    "            c += digit;",
    "            digit = (ll)(c % radix);",
    "            c /= radix;",
    "        }",
    "        while(c){",
    "            ret.push_back((ll)(c % radix));",
    "            c /= radix;",
    "        }",
    "        while(ret.size() > 1 && !ret.back()) ret.pop_back();",
    "        return make(ret);",
    "    }",
    "};"
  ],
  "description": "Integer FFT arrays: _fft<N>, make(vector<T>), +/*, inverse<T=ll>(), carry(node, radix=10) returning node, and ostream output from high to low index without separators. Carry needs nonnegative coefficients and radix>=2; all intermediate lengths including carried digits must fit the rounded capacity."
}
}
