{
  "ch": {
    "prefix": ">>ch",
    "body": [
      "class _ch{",
      "public:",
      "    class node{",
      "    public:",
      "        ll x, y, idx;",
      "        node(pll a, ll idx) : node(a.x, a.y, idx) {};",
      "        node(ll x, ll y, ll idx) : x(x), y(y), idx(idx){}",
      "        operator pll() const{ return { x, y }; }",
      "    };",
      "private:",
      "    vector <node> arr, st;",
      "    vector <pll> p; ll cnt = 0;",
      "public:",
      "    _ch() {}",
      "",
      "    i128 dist2(pll v1, pll v2) const{",
      "        i128 dx = (i128)v1.x - v2.x, dy = (i128)v1.y - v2.y;",
      "        return dx * dx + dy * dy;",
      "    }",
      "",
      "    ll ccw(pll v1, pll v2, pll v3){ return _ccw::ret(v1, v2, v3); } // O(1)",
      "",
      "    void clear(){ // O(n)",
      "        arr.clear(); st.clear(); p.clear(); cnt = 0;",
      "    }",
      "",
      "    void make(span<const pll> v){ // O(n)",
      "        arr.clear(); cnt = 0;",
      "        for(const auto& i : v) add(i);",
      "        st.clear(); p.clear();",
      "    }",
      "",
      "    ll add(ll a, ll b){ return add({a, b}); }",
      "    ll add(pll a){ arr.push_back({a, cnt}); return cnt++; }",
      "",
      "    void build(){ // O(n log n)",
      "        st.clear(); p.clear();",
      "        auto v = arr;",
      "        sort(all(v), [&](const node& a, const node& b){",
      "            return tie(a.x, a.y, a.idx) < tie(b.x, b.y, b.idx);",
      "        });",
      "        v.erase(unique(all(v), [&](const node& a, const node& b){",
      "            return a.x == b.x && a.y == b.y;",
      "        }), v.end());",
      "        if(v.empty()) return;",
      "        for(const auto& i : v){",
      "            while(st.size() >= 2 && ccw(st[st.size() - 2], st.back(), i) <= 0) st.pop_back();",
      "            st.push_back(i);",
      "        }",
      "        ll sz = st.size();",
      "        for(ll i = (ll)v.size() - 2;i >= 0;i--){",
      "            while(st.size() > sz && ccw(st[st.size() - 2], st.back(), v[i]) <= 0) st.pop_back();",
      "            st.push_back(v[i]);",
      "        }",
      "        if(st.size() > 1) st.pop_back();",
      "        for(const auto& i : st) p.push_back(i);",
      "    }",
      "",
      "    const vector <pll>& ret() const{ return p; } // O(1)",
      "    const vector <node>& idx() const{ return st; } // O(1)",
      "};"
    ],
    "description": "Convex hull; requires >>ccw. make(span<const pll>) replaces input without building; clear() resets input and results. add() returns the insertion ID; duplicate coordinates still receive distinct IDs. IDs restart at zero after make/clear. build() preserves input, removes duplicate coordinates (keeping the first ID), and returns strict CCW vertices from the lexicographic minimum through ret()/idx(). dist2(a,b) returns squared distance as i128; its intermediate arithmetic must fit i128."
  }
}
