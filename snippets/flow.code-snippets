    "        while(!q.empty()){",
    "            int cur = q.front(); q.pop();",
    "            for(const auto& e : adj[cur]){",
    "                if(e.c <= 0 || v[e.nxt]) continue;",
    "                v[e.nxt] = 1; q.push(e.nxt);",
    "            }",
    "        }",
    "        return v;",
    "    }",
    "",
    "    bool reachable(int st, int en) const{ return min_cut(st)[en]; } // O(n + m)",
    "",
    "    template <class F>",
    "    void it_idx(int idx, const F& f){ // O(|ids[idx]|)",
