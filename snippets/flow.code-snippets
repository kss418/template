    "            T f = e.cap - e.c; e.cap = cap;",
    "            e.c = cap - f; re.c = f;",
    "        }",
    "    };",
    "private:",
    "    vector <int> d, w; int n; T result;",
    "    vector <vector<edge>> adj;",
