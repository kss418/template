  "body": [
    "class _3cycle{",
    "private:",
    "    bool base;",
    "    vector <vector<int>> tmp, adj;",
    "    int n; ll result = 0;",
    "public:",
    "    _3cycle(int n = 0, bool base = 1){ clear(n, base); } // O(n)",
    "    void clear(int n, bool base = 1){ // O(n)",
    "        this->n = n; this->base = base; adj.assign(n + 1, {}); result = 0;",
    "        tmp.assign(n + 1, {});",
    "    }",
    "",
    "    void add(int st, int en){ tmp[st].push_back(en); tmp[en].push_back(st); } // O(1)",
    "",
    "    void build(ll mod = 0){ // O(n + m sqrt m)",
    "        adj.assign(n + 1, {}); result = 0;",
    "        for(int i = base;i <= n;i++){",
    "            for(auto& j : tmp[i]){",
    "                if(tmp[i].size() < tmp[j].size()) continue;",
    "                if(tmp[i].size() == tmp[j].size() && i <= j) continue;",
    "                adj[i].push_back(j);",
    "            }",
    "        }",
    "",
    "        it_triangle([&](int, int, int){ result++; if(mod) result %= mod; });",
    "    }",
    "    ll ret() const{ return result; } // O(1)",
    "",
    "    template <class F>",
    "    void it_triangle(const F& f) const{ // O(n + m sqrt m)",
    "        vector<int> mark(n + 1, -1);",
    "        for(int i = base;i <= n;i++){",
    "            for(auto& j : adj[i]) mark[j] = i;",
    "            for(auto& j : adj[i]){",
    "                for(auto& k : adj[j]) if(mark[k] == i) f(i, j, k);",
    "            }",
    "        }",
    "    }",
    "};"
  ],
  "description": "3cycle"
}
