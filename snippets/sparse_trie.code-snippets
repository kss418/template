    "prefix": ">>sparse_trie",
    "body": [
      "template <class T = ll>",
      "class _sparse_trie{",
      "private:",
      "    vector <map<T, int>> adj;",
      "    vector <int> cnt, pass;",
      "",
      "    int new_node(){",
      "        adj.emplace_back(); cnt.push_back(0); pass.push_back(0);",
      "        return (int)adj.size() - 1;",
      "    }",
      "",
      "    int child(int idx, const T& c) const{ // O(log(degree + 1))",
      "        auto it = adj[idx].find(c);",
      "        return it == adj[idx].end() ? 0 : it->second;",
      "    }",
      "",
      "    vector <T> tf(const string& s) const{ // O(|s|)",
      "        vector <T> ret; ret.reserve(s.size());",
      "        for(unsigned char c : s) ret.push_back(static_cast<T>(c));",
      "        return ret;",
      "    }",
      "public:",
      "    class state{",
      "    private:",
      "        friend class _sparse_trie;",
      "        const _sparse_trie* owner;",
      "        int idx;",
      "        state(const _sparse_trie* owner, int idx) : owner(owner), idx(idx){}",
      "    public:",
      "        int id() const{ return idx; } // O(1)",
      "        int count() const{ return idx == -1 ? 0 : owner->cnt[idx]; } // O(1)",
      "        int prefix_count() const{ return idx == -1 ? 0 : owner->pass[idx]; } // O(1)",
      "        bool end() const{ return count() > 0; } // O(1)",
      "        bool valid() const{ return id() != -1; } // O(1)",
      "        bool has_child() const{ return prefix_count() > count(); } // O(1)",
      "",
      "        state go(const T& c) const{ // O(log(degree + 1))",
      "            if(idx < 0 || idx >= (int)owner->adj.size()) return {owner, -1};",
      "            int nxt = owner->child(idx, c);",
      "            return {owner, nxt ? nxt : -1};",
      "        }",
      "",
      "        template<class F>",
      "        void it_child(const F& f) const{ // O(degree)",
      "            if(idx < 0 || idx >= (int)owner->adj.size()) return;",
      "            for(const auto& [c, nxt] : owner->adj[idx]){",
      "                if(owner->pass[nxt]) f(c, state(owner, nxt));",
      "            }",
      "        }",
      "",
      "        template<class F>",
      "        void it_subtree(const F& f) const{ // O(nodes + edges)",
      "            if(idx < 0 || idx >= (int)owner->adj.size() || !owner->pass[idx]) return;",
      "            f(*this);",
      "            it_child([&](const T&, state nxt){ nxt.it_subtree(f); });",
      "        }",
      "    };",
      "",
      "    _sparse_trie(){ clear(); } // O(1)",
      "    void clear(){ adj.clear(); cnt.clear(); pass.clear(); new_node(); } // O(nodes + edges)",
      "",
      "    state get_state(const string& s) const{ auto v = tf(s); return get_state(v); } // O(|s| * log(D + 1))",
      "    state get_state(span<const T> v) const{ // O(|v| * log(D + 1))",
      "        int cur = 0;",
      "        for(const auto& c : v){",
      "            int nxt = child(cur, c);",
      "            if(!nxt) return {this, -1};",
      "            cur = nxt;",
      "        }",
      "        return {this, cur};",
      "    }",
      "",
      "    int size() const{ return pass[0]; } // O(1)",
      "    state insert(const string& s){ auto v = tf(s); return insert(v); } // O(|s| * log(D + 1))",
      "    state insert(span<const T> v){ // O(|v| * log(D + 1))",
      "        int cur = 0; pass[cur]++;",
      "        for(const auto& c : v){",
      "            int nxt = child(cur, c);",
      "            if(!nxt){",
      "                nxt = new_node(); adj[cur].emplace(c, nxt);",
      "            }",
      "            cur = nxt; pass[cur]++;",
      "        }",
      "        cnt[cur]++; return {this, cur};",
      "    }",
      "",
      "    bool erase(const string& s){ auto v = tf(s); return erase(v); } // O(|s| * log(D + 1))",
      "    bool erase(span<const T> v){ // O(|v| * log(D + 1))",
      "        int idx = get_state(v).id();",
      "        if(idx == -1 || !cnt[idx]) return 0;",
      "        int cur = 0; cnt[idx]--; pass[cur]--;",
      "        for(const auto& c : v){ cur = child(cur, c); pass[cur]--; }",
      "        return 1;",
      "    }",
      "",
      "    int rank(const string& s) const{ auto v = tf(s); return rank(v); } // O(|s| * D)",
      "    int rank(span<const T> v) const{ // O(|v| * D)",
      "        int ret = 0, cur = 0;",
      "        for(const auto& c : v){",
      "            ret += cnt[cur];",
      "            auto stop = adj[cur].lower_bound(c);",
      "            for(auto it = adj[cur].begin();it != stop;++it) ret += pass[it->second];",
      "            int nxt = child(cur, c);",
      "            if(!nxt) return ret;",
      "            cur = nxt;",
      "        }",
      "        return ret;",
      "    }",
      "",
      "    vector <T> kth(int k) const{ // O(max_len * D)",
      "        if(k <= 0 || k > pass[0]) return {};",
      "        vector <T> ret; int cur = 0;",
      "        while(1){",
      "            if(k <= cnt[cur]) break;",
      "            k -= cnt[cur];",
      "            for(const auto& [c, nxt] : adj[cur]){",
      "                if(pass[nxt] >= k){",
      "                    ret.push_back(c); cur = nxt; break;",
      "                }",
      "                k -= pass[nxt];",
      "            }",
      "        }",
      "        return ret;",
      "    }",
      "};"
    ],
    "description": "Sparse trie with ordered labels and state traversal."
  }
