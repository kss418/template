      "    }",
      "",
      "    void make(span<const node> values){ // O(n)",
      "        vector<node> next(values.size(), leaf());",
      "        for(int i = base;i < (int)values.size();i++) next[i] = values[i];",
      "        _uf::clear(values.empty() ? base - 1 : (int)values.size() - 1, base);",
      "        arr.swap(next);",
      "    }",
      "",
      "    bool merge(int a, int b){ // O(alpha(n)) amortized + policy::merge",
      "        if(!merge_internal(a, b)) return false;",
      "        policy::merge(arr[a], arr[b]);",
      "        return true;",
      "    }",
      "",
