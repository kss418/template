    "    vector<query> q;",
    "private:",
    "    vector<ll> result;",
    "public:",
    "    _pbs(ll lo = 0, ll hi = -1){ clear(lo, hi); } // O(1)",
    "    void clear(ll lo = 0, ll hi = -1){ // O(q)",
    "        this->lo = lo; this->hi = hi;",
    "        q.clear(); result.clear();",
    "    }",
    "",
    "    int add(query a){ // O(1) amortized",
