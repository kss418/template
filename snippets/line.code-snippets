{
"line": {
  "prefix": ">>line",
  "body": [
    "template <signed_integral T = i128>",
    "class _line{ ",
    "private:",
    "    _frac<T> a, b; T x = 0; bool vert = false;",
    "public:",
    "    enum class relation_type{ point, parallel, coincident };",
    "",
    "    _line() = default;",
    "    _line(const pair<T, T>& p1, const pair<T, T>& p2){",
    "        if(p1.x == p2.x){",
    "            vert = true; x = p1.x;",
    "            a = _frac<T>(), b = _frac<T>();",
    "        }",
    "        else{",
    "            vert = false;",
    "            T dx = (T)p2.x - p1.x, dy = (T)p2.y - p1.y;",
    "            a = _frac<T>(dy, dx), b = _frac<T>(p1.y) - a * _frac<T>(p1.x);",
    "        }",
    "    }",
    "",
    "    _line(const _frac<T>& slope, const pair<T, T>& p){",
    "        vert = false; x = 0;",
    "        a = slope; b = _frac<T>(p.y) - a * _frac<T>(p.x);",
    "    }",
    "",
    "    bool is_vertical() const{ return vert; } // O(1)",
    "    const _frac<T>& slope() const{ assert(!vert); return a; } // O(1)",
    "    const _frac<T>& intercept() const{ assert(!vert); return b; } // O(1)",
    "    T vertical_x() const{ assert(vert); return x; } // O(1)",
    "",
    "    _frac<T> f(const _frac<T>& x) const{",
    "        assert(!vert);",
    "        return a * x + b;",
    "    }",
    "",
    "    relation_type relation(const _line& ot) const{ // O(1)",
    "        if(vert != ot.vert) return relation_type::point;",
    "        if(vert) return x == ot.x ? relation_type::coincident : relation_type::parallel;",
    "        if(a != ot.a) return relation_type::point;",
    "        return b == ot.b ? relation_type::coincident : relation_type::parallel;",
    "    }",
    "",
    "    bool contains(const pair<_frac<T>, _frac<T>>& p) const{ // O(1)",
    "        if(vert) return p.x == x;",
    "        return f(p.x) == p.y;",
    "    }",
    "",
    "    optional<pair<_frac<T>, _frac<T>>> intersect(const _line& ot) const{",
    "        if(relation(ot) != relation_type::point) return nullopt;",
    "        if(vert){",
    "            _frac<T> p1 = _frac<T>(x), p2 = ot.f(p1);",
    "            return pair{p1, p2};",
    "        }",
    "        if(ot.vert){",
    "            _frac<T> p1 = _frac<T>(ot.x), p2 = f(p1);",
    "            return pair{p1, p2};",
    "        }",
    "        _frac<T> p1 = (ot.b - b) / (a - ot.a), p2 = f(p1);",
    "        return pair{p1, p2};",
    "    }",
    "",
    "    bool same(const _line& ot) const{ return relation(ot) == relation_type::coincident; } // O(1)",
    "};"
  ],
  "description": "Exact lines over signed_integral T (default i128), using _frac<T>. Requires >>frac. Construct from two distinct pair<T,T> points or a slope and an integer point; all remaining coordinate and fraction arithmetic must fit T. is_vertical() identifies vertical lines; slope()/intercept()/f() require a nonvertical line, vertical_x() requires a vertical line. relation() returns relation_type::point/parallel/coincident. contains() accepts fraction-coordinate pairs and convertible integer-coordinate pairs. intersect(other) returns optional<pair<_frac<T>, _frac<T>>>: coordinates for a unique intersection, nullopt for parallel or coincident lines; same() tests coincidence."
}
}
