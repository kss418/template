{
"inter": {
  "prefix": ">>inter",
  "body": [
    "// https://github.com/kss418/template/blob/master/docs/Geometry.md#inter",
    "namespace _inter{",
    "    enum class location{ outside, boundary, inside };",
    "",
    "    inline location locate(span<const pll> p, pll now){ // O(n)",
    "        ll sz = p.size();",
    "        if(sz < 3) return location::outside;",
    "        bool inside = 0;",
    "        for(ll i = 0;i < sz;i++){",
    "            auto a = p[i], b = p[(i + 1) % sz];",
    "            if(_li::on_segment(a, b, now)) return location::boundary;",
    "            if((a.y > now.y) != (b.y > now.y) && (_li::ccw(a, b, now) > 0) == (b.y > a.y)) inside = !inside;",
    "        }",
    "        return inside ? location::inside : location::outside;",
    "    }",
    "",
    "    inline bool ret(span<const pll> p, pll now){ return locate(p, now) != location::outside; } // O(n)",
    "}"
  ],
  "description": "Point-in-polygon via horizontal ray parity, O(n) time and O(1) extra space; requires >>li. _inter::locate returns location::outside/boundary/inside; ret includes boundary. Vertices follow the simple polygon boundary in either direction; fewer than three vertices return outside. CCW intermediates must fit i128."
}
}
