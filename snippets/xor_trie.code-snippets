    "        }",
    "        int cur = 0, ret = 0;",
    "        for(int i = m;i >= 0;i--){",
    "            bool kb = (k >> i) & 1ull, xb = (x >> i) & 1ull;",
    "            if(kb){   ",
    "                if(adj[cur][xb]) ret += pass[adj[cur][xb]];",
    "                if(!adj[cur][xb ^ 1]) return ret;",
    "            }",
    "            else if(!adj[cur][xb]) return ret;",
    "            cur = adj[cur][xb ^ kb];",
    "        }",
    "        return ret;",
    "    }",
    "};"
