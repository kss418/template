{
"dot": {
  "prefix": ">>dot",
  "body": [
    "// https://github.com/kss418/template/blob/master/docs/Geometry.md#dot",
    "namespace _dot{",
    "    inline ll ret(pll a, pll b){ // O(1)",
    "        return (ll)((i128)a.x * b.x + (i128)a.y * b.y);",
    "    }",
    "",
    "    // ret > 0 -> angle < 90, ret < 0 -> angle > 90, ret == 0 -> angle == 90",
    "    inline ll ret(pll l, pll m, pll r){ // O(1)",
    "        i128 ax = (i128)m.x - l.x, ay = (i128)m.y - l.y;",
    "        i128 bx = (i128)m.x - r.x, by = (i128)m.y - r.y;",
    "        return (ll)(ax * bx + ay * by);",
    "    }",
    "",
    "    inline ll ret(ll x1, ll y1, ll x2, ll y2, ll x3, ll y3){ return ret({x1, y1}, {x2, y2}, {x3, y3}); } // O(1)",
    "}"
  ],
  "description": "Inline _dot::ret overloads for two vectors, three points (middle point is the vertex), or six coordinates. Differences, products, and sums use i128; all intermediate arithmetic must fit i128 and the final dot product must fit the ll return type."
}
}