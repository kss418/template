  "mnc": {
    "prefix": ">>mnc",
    "body": [
      "template <class T = ll>",
      "class _mnc{ // 0-based index",
      "private:",
      "    vector <T> arr; vector <int> rad;",
      "    int n = 0, m = 0; ll even = 0, odd = 0;",
      "    void build(){ // O(n)",
      "        n = arr.size(); rad.assign(2 * n + 1, 0);",
      "        even = odd = m = 0;",
      "        int l = 0, r = -1;",
      "        for(int i = 0;i < n;i++){",
      "            int k = 1;",
      "            if(i <= r) k = min(rad[2 * (l + r - i) + 1] / 2 + 1, r - i + 1);",
      "            while(i - k >= 0 && i + k < n && arr[i - k] == arr[i + k]) k++;",
      "            rad[2 * i + 1] = 2 * k - 1; odd += k;",
      "            m = max(m, 2 * k - 1);",
      "            if(i + k - 1 > r){ l = i - k + 1; r = i + k - 1; }",
      "        }",
      "        l = 0; r = -1;",
      "        for(int i = 0;i < n;i++){",
      "            int k = 0;",
      "            if(i <= r) k = min(rad[2 * (l + r - i + 1)] / 2, r - i + 1);",
      "            while(i - k - 1 >= 0 && i + k < n && arr[i - k - 1] == arr[i + k]) k++;",
      "            rad[2 * i] = 2 * k; even += k;",
      "            m = max(m, 2 * k);",
      "            if(i + k - 1 > r){ l = i - k; r = i + k - 1; }",
      "        }",
      "    }",
      "",
      "    template <class It, class F>",
      "    void make(It begin, It end, const F& f){",
      "        size_t len = (size_t)distance(begin, end);",
      "        arr.clear(); arr.reserve(len);",
      "        for(auto it = begin;it != end;++it) arr.push_back(f(*it));",
      "        build();",
      "    }",
      "public:",
      "    _mnc(){} // O(1)",
      "    _mnc(const string& s){ make(s); } // O(n)",
      "    _mnc(span<const T> v){ make(v); } // O(n)",
      "    void make(const string& s){ make(all(s), [&](char c){ return (unsigned char)c; }); } // O(n)",
      "    void make(span<const T> v){ make(all(v), [&](const T& x){ return x; }); } // O(n)",
      "",
      "    const vector<int>& get_rad() const{ return rad; } // O(1)",
      "    ll cnt() const{ return odd + even; } // O(1)",
      "    ll cnt_odd() const{ return odd; } // O(1)",
      "    ll cnt_even() const{ return even; } // O(1)",
      "    int max_len() const{ return m; } // O(1)",
      "    bool is_pal(int l, int r) const{ // O(1)",
      "        int m = l + r + 1;",
      "        return rad[m] >= r - l + 1;",
      "    }",
      "",
      "    pair<int, int> range_odd(int idx) const{ // O(1)",
      "        int r = rad[2 * idx + 1] / 2;",
      "        return { idx - r, idx + r };",
      "    }",
      "",
      "    pair<int, int> range_even(int idx) const{ // O(1)",
      "        int r = rad[2 * idx] / 2;",
      "        return { idx - r, idx + r - 1 };",
      "    }",
      "};"
    ],
    "description": "mnc"
  }
