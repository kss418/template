      "class _rc{",
      "public:",
      "    using node = _ch::node;",
      "private:",
      "    vector <node> p;",
      "    pair <pll, pll> result{}; pll ids = {-1, -1};",
      "    i128 mx = 0; ld len = 0;",
      "",
      "    i128 area(ll a, ll b, ll c) const{",
      "        i128 ret = _ccw::cross(p[a], p[b], p[c]);",
      "        return ret < 0 ? -ret : ret;",
      "    }",
      "",
      "    void update(ll l, ll r){",
      "        i128 dx = (i128)p[l].x - p[r].x, dy = (i128)p[l].y - p[r].y;",
      "        i128 now = dx * dx + dy * dy;",
      "        if(p[l].idx > p[r].idx) swap(l, r);",
      "        pll id = {p[l].idx, p[r].idx};",
      "        if(now < mx || (now == mx && id >= ids)) return;",
      "        mx = now; result = {pll(p[l]), pll(p[r])}; ids = id;",
      "    }",
      "public:",
      "    void build(span<const node> arr){ p.assign(all(arr)); build(); } // O(n)",
      "    void build(span<const pll> arr){ // O(n)",
      "        p.clear(); p.reserve(arr.size());",
      "        for(ll i = 0;i < arr.size();i++) p.push_back({arr[i], i});",
      "        build();",
      "    }",
      "",
      "    void build(){ // O(n)",
      "        auto same = [](const node& a, const node& b){ return a.x == b.x && a.y == b.y; };",
      "        ll cnt = 0;",
      "        for(auto i : p){",
      "            if(cnt && same(p[cnt - 1], i)) p[cnt - 1].idx = min(p[cnt - 1].idx, i.idx);",
      "            else p[cnt++] = i;",
      "        }",
      "        p.erase(p.begin() + cnt, p.end());",
      "        if(p.size() > 1 && same(p.front(), p.back())){",
      "            p.front().idx = min(p.front().idx, p.back().idx);",
      "            p.pop_back();",
      "        }",
      "        mx = 0; len = 0; result = {}; ids = {-1, -1};",
      "        ll sz = p.size(); if(!sz) return;",
      "        result = {pll(p[0]), pll(p[0])}; ids = {p[0].idx, p[0].idx};",
      "        if(sz == 1) return;",
      "        bool line = 1;",
      "        for(ll i = 2;i < sz;i++) if(area(0, 1, i)){ line = 0; break; }",
      "        if(line){",
      "            ll l = 0, r = 0;",
      "            for(ll i = 1;i < sz;i++){",
      "                if(tie(p[i].x, p[i].y, p[i].idx) < tie(p[l].x, p[l].y, p[l].idx)) l = i;",
      "                if(tie(p[i].x, p[i].y) > tie(p[r].x, p[r].y) || (same(p[i], p[r]) && p[i].idx < p[r].idx)) r = i;",
      "            }",
      "            update(l, r);",
      "        }",
      "        else{",
      "            ll r = 1;",
      "            for(ll l = 0;l < sz;l++){",
      "                ll nxt = (l + 1) % sz;",
      "                r = max(r, l + 1);",
      "                while(r + 1 < l + sz && area(l, nxt, (r + 1) % sz) >= area(l, nxt, r % sz)){",
      "                    update(l, r % sz); update(nxt, r % sz); r++;",
      "                }",
      "                update(l, r % sz); update(nxt, r % sz);",
      "            }",
      "        }",
      "        len = sqrtl(mx);",
      "    }",
      "",
      "    const pair <pll, pll>& ret() const{ return result; } // O(1)",
      "    const pll& idx() const{ return ids; } // O(1)",
      "    ll dist2() const{ return (ll)mx; } // O(1)",
      "    ld dist() const{ return len; } // O(1)",
      "};"
    ],
    "description": "Convex-polygon diameter; requires >>ch for _ch::node and its >>ccw dependency. build(hull.idx()) preserves original IDs; build(hull.ret()) uses polygon positions. Consecutive and closing duplicate coordinates retain the minimum ID, using in-place compaction. Equal diameters choose the lexicographically smallest sorted ID pair, with matching endpoint order. Distance arithmetic and storage use i128; dist2() returns ll and requires the final squared distance to fit ll. Cached ret/idx/dist2/dist getters; CCW and squared-distance intermediates must fit i128."
  }
