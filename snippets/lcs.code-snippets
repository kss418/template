  "prefix": ">>lcs",
  "body": [
    "class _lcs{",
    "private:",
    "    string a, b;",
    "    vector <vector<ll>> dp;",
    "    ll n, m;",
    "public:",
    "    _lcs() : _lcs(\"\", \"\"){}",
    "    _lcs(const string& a, const string& b){ build(a, b); }",
    "",
    "    void build(const string& s, const string& t){",
    "        a = s; b = t;",
    "        n = a.size(); m = b.size(); dp.assign(n + 1, vector<ll>(m + 1, 0));",
    "        for(int i = 0;i < n;i++){",
    "            for(int j = 0;j < m;j++){",
    "                if(a[i] == b[j]){",
    "                    dp[i + 1][j + 1] = dp[i][j] + 1;",
    "                }",
    "                else{",
    "                    dp[i + 1][j + 1] = max(dp[i][j + 1], dp[i + 1][j]);",
    "                }",
    "            }",
    "        }",
    "    }",
    "",
    "    ll ret(){ return dp[n][m]; } // lcs 길이 반환",
    "",
    "    string track(){ // lcs string 반환",
    "        string ret; ll cy = n, cx = m;",
    "        while(cy && cx){",
    "            if(a[cy - 1] == b[cx - 1]){",
    "                ret.push_back(a[cy - 1]); cy--; cx--;",
    "            }",
    "            else if(dp[cy - 1][cx] > dp[cy][cx - 1]) cy--;",
    "            else cx--;",
    "        }",
    "        reverse(ret.begin(), ret.end());",
    "        return ret;",
    "    }",
    "};"
  ],
  "description": "lcs"
}
}