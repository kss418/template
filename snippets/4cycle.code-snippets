  "body": [
    "class _4cycle{",
    "private:",
    "    bool base;",
    "    vector <vector<int>> tmp, adj;",
    "    vector<ll> participation;",
    "    int n; ll result = 0;",
    "    bool less(int a, int b) const{",
    "        if(tmp[a].size() < tmp[b].size()) return 1;",
    "        return tmp[a].size() == tmp[b].size() && a <= b;",
    "    }",
    "",
    "    template <class F>",
    "    void it_path(int cur, const F& f) const{",
    "        for(auto& j : adj[cur]){",
    "            for(auto& k : tmp[j]) if(!less(cur, k)) f(j, k);",
    "        }",
    "    }",
    "public:",
    "    _4cycle(int n = 0, bool base = 1){ clear(n, base); } // O(n)",
    "    void clear(int n, bool base = 1){ // O(n)",
    "        this->n = n; this->base = base; adj.assign(n + 1, {}); result = 0;",
    "        participation.assign(n + 1, 0); tmp.assign(n + 1, {});",
    "    }",
    "",
    "    void add(int st, int en){ tmp[st].push_back(en); tmp[en].push_back(st); } // O(1)",
    "",
    "    void build(ll mod = 0){ // O(n + m sqrt m)",
    "        adj.assign(n + 1, {}); participation.assign(n + 1, 0); result = 0;",
    "        for(int i = base;i <= n;i++){",
    "            for(auto& j : tmp[i]) if(!less(i, j)) adj[i].push_back(j);",
    "        }",
    "",
    "        vector<int> cnt(n + 1, 0), use;",
    "        auto accumulate = [&](ll& v, ll delta){",
    "            if(mod) v = (i128(v) + delta) % mod;",
    "            else v += delta;",
    "        };",
    "        for(int i = base;i <= n;i++){",
    "            use.clear();",
    "            it_path(i, [&](int, int k){ if(!cnt[k]) use.push_back(k); cnt[k]++; });",
    "            for(int k : use){",
    "                ll ways = 1ll * cnt[k] * (cnt[k] - 1) / 2;",
    "                accumulate(result, ways); accumulate(participation[i], ways); accumulate(participation[k], ways);",
    "            }",
    "            it_path(i, [&](int j, int k){ accumulate(participation[j], cnt[k] - 1); });",
    "            for(int k : use) cnt[k] = 0;",
    "        }",
    "    }",
    "    ll ret() const{ return result; } // O(1)",
    "    ll count(int v) const{ return participation[v]; } // O(1)",
    "",
    "    template <class F>",
    "    void it_cycle(const F& f) const{ // O(n + m sqrt m + C4)",
    "        vector<int> head(n + 1, -1), use;",
    "        vector<pair<int, int>> path;",
    "        for(int i = base;i <= n;i++){",
    "            use.clear(); path.clear();",
    "            it_path(i, [&](int j, int k){",
    "                if(head[k] == -1) use.push_back(k);",
    "                for(int idx = head[k];idx != -1;idx = path[idx].second) f(i, j, k, path[idx].first);",
    "                path.push_back({j, head[k]}); head[k] = (int)path.size() - 1;",
    "            });",
    "            for(int k : use) head[k] = -1;",
    "        }",
    "    }",
    "};"
  ],
