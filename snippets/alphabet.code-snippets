{
  "alphabet": {
    "prefix": ">>alphabet",
    "body": [
      "namespace alphabet {",
      "class lowercase {",
      "public:",
      "    static constexpr int size = 26;",
      "    static constexpr int encode(unsigned char c){",
      "        assert('a' <= c && c <= 'z');",
      "        return c - 'a';",
      "    }",
      "    static constexpr unsigned char decode(int i){",
      "        assert(0 <= i && i < size);",
      "        return 'a' + i;",
      "    }",
      "};",
      "class digits {",
      "public:",
      "    static constexpr int size = 10;",
      "    static constexpr int encode(unsigned char c){",
      "        assert('0' <= c && c <= '9');",
      "        return c - '0';",
      "    }",
      "    static constexpr unsigned char decode(int i){",
      "        assert(0 <= i && i < size);",
      "        return '0' + i;",
      "    }",
      "};",
      "class alnum {",
      "public:",
      "    static constexpr int size = 62;",
      "    static constexpr int encode(unsigned char c){",
      "        if('0' <= c && c <= '9') return c - '0';",
      "        if('A' <= c && c <= 'Z') return 10 + c - 'A';",
      "        assert('a' <= c && c <= 'z');",
      "        return 36 + c - 'a';",
      "    }",
      "    static constexpr unsigned char decode(int i){",
      "        assert(0 <= i && i < size);",
      "        if(i < 10) return '0' + i;",
      "        if(i < 36) return 'A' + i - 10;",
      "        return 'a' + i - 36;",
      "    }",
      "};",
      "class bytes {",
      "public:",
      "    static constexpr int size = 256;",
      "    static constexpr int encode(unsigned char c){ return c; }",
      "    static constexpr unsigned char decode(int i){",
      "        assert(0 <= i && i < size);",
      "        return static_cast<unsigned char>(i);",
      "    }",
      "};",
      "}"
    ],
    "description": "Character alphabet policies: lowercase, digits, alnum and bytes."
  }
}
